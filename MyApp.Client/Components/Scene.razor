@*
    Full-viewport lake scene behind the game (fixed, z-index -1, no pointer events, hidden from screen readers).
    Static scenery is plain inline SVG; only a few small layers animate, and only with CSS transform/opacity
    (waves, clouds, light rays, fish, bubbles, seaweed). Free = sunset mood: a second sky/water layer and the sun
    fade in over ~1 s. Everything is markup + Scene.razor.css; no images, no JS.
*@
<div class="scene @(Free ? "free" : null)" aria-hidden="true">
    <div class="sky-sunset"></div>
    <div class="sun"></div>

    <div class="cloud c1"><svg viewBox="0 0 120 50"><path d="M18 42 a13 13 0 0 1 8 -23 a18 18 0 0 1 33 -7 a14 14 0 0 1 25 7 a12 12 0 0 1 16 23 Z" /></svg></div>
    <div class="cloud c2"><svg viewBox="0 0 120 50"><path d="M18 42 a13 13 0 0 1 8 -23 a18 18 0 0 1 33 -7 a14 14 0 0 1 25 7 a12 12 0 0 1 16 23 Z" /></svg></div>
    <div class="cloud c3"><svg viewBox="0 0 120 50"><path d="M18 42 a13 13 0 0 1 8 -23 a18 18 0 0 1 33 -7 a14 14 0 0 1 25 7 a12 12 0 0 1 16 23 Z" /></svg></div>

    @* Far hills, pine trees and a little wooden pier on the horizon. *@
    <svg class="shore" viewBox="0 0 1600 160" preserveAspectRatio="xMidYMax slice">
        <defs>
            <symbol id="scene-pine" viewBox="0 0 40 80">
                <path d="M20 0 L33 28 H26 L37 50 H28 L40 72 H0 L12 50 H3 L14 28 H7 Z" />
                <rect x="17" y="71" width="6" height="9" />
            </symbol>
        </defs>
        <path class="far" d="M0 160 V100 Q120 70 260 92 T520 84 Q680 60 820 88 T1120 80 Q1300 56 1440 86 T1600 78 V160 Z" />
        <path class="near" d="M0 160 V118 Q90 104 200 116 Q300 128 380 150 L400 160 Z" />
        <path class="near" d="M1600 160 V112 Q1500 100 1390 114 Q1290 128 1220 150 L1200 160 Z" />
        <g class="pine">
            <use href="#scene-pine" x="14" y="58" width="32" height="64" />
            <use href="#scene-pine" x="48" y="44" width="38" height="76" />
            <use href="#scene-pine" x="88" y="62" width="28" height="56" />
            <use href="#scene-pine" x="122" y="52" width="34" height="68" />
            <use href="#scene-pine" x="166" y="70" width="26" height="52" />
            <use href="#scene-pine" x="1262" y="70" width="28" height="56" />
            <use href="#scene-pine" x="1300" y="54" width="34" height="68" />
            <use href="#scene-pine" x="1344" y="40" width="40" height="80" />
            <use href="#scene-pine" x="1392" y="56" width="32" height="64" />
            <use href="#scene-pine" x="1440" y="46" width="36" height="72" />
            <use href="#scene-pine" x="1488" y="60" width="30" height="60" />
            <use href="#scene-pine" x="1530" y="48" width="36" height="72" />
        </g>
        <g class="dock">
            <rect x="372" y="139" width="4" height="21" />
            <rect x="420" y="141" width="4" height="19" />
            <rect x="468" y="141" width="4" height="19" />
            <rect x="516" y="141" width="4" height="19" />
            <rect x="564" y="141" width="4" height="19" />
            <rect x="608" y="139" width="4" height="21" />
            <rect x="360" y="142" width="256" height="5" rx="1" />
            <circle cx="374" cy="138" r="3" />
            <circle cx="610" cy="138" r="3" />
        </g>
    </svg>

    <div class="waves back"></div>
    <div class="waves front"></div>
    <div class="rays"></div>

    <div class="fish f1" style="--x: 12vw"><svg viewBox="0 0 60 30"><path d="M8 15 Q22 3 40 9 L54 2 L50 15 L54 28 L40 21 Q22 27 8 15 Z" /></svg></div>
    <div class="fish f2 rev" style="--x: 70vw"><svg viewBox="0 0 60 30"><path d="M8 15 Q22 3 40 9 L54 2 L50 15 L54 28 L40 21 Q22 27 8 15 Z" /></svg></div>
    <div class="fish f3" style="--x: 55vw"><svg viewBox="0 0 60 30"><path d="M8 15 Q22 3 40 9 L54 2 L50 15 L54 28 L40 21 Q22 27 8 15 Z" /></svg></div>
    <div class="fish f4 rev" style="--x: 28vw"><svg viewBox="0 0 60 30"><path d="M8 15 Q22 3 40 9 L54 2 L50 15 L54 28 L40 21 Q22 27 8 15 Z" /></svg></div>

    <div class="bubbles b1"><div class="rise"></div></div>
    <div class="bubbles b2"><div class="rise"></div></div>
    <div class="bubbles b3"><div class="rise"></div></div>
    <div class="bubbles b4"><div class="rise"></div></div>

    @* Sand, rocks, a starfish and a shell on the lake bed. *@
    <svg class="seabed" viewBox="0 0 1600 200" preserveAspectRatio="xMidYMax slice">
        <path class="sand-back" d="M0 200 V120 Q200 90 420 118 T860 110 Q1080 90 1300 118 T1600 108 V200 Z" />
        <ellipse class="rock" cx="190" cy="160" rx="48" ry="28" />
        <ellipse class="rock dark" cx="250" cy="172" rx="30" ry="18" />
        <ellipse class="rock" cx="1390" cy="150" rx="54" ry="30" />
        <ellipse class="rock dark" cx="1460" cy="168" rx="30" ry="18" />
        <path class="sand" d="M0 200 V162 Q260 132 520 158 T1040 152 Q1300 130 1600 152 V200 Z" />
        <ellipse class="rock dark" cx="830" cy="178" rx="26" ry="13" />
        <path class="star" d="M560 160 l5 11 12 1 -9 8 3 12 -11 -6 -11 6 3 -12 -9 -8 12 -1 Z" />
        <path class="shell" d="M1120 186 q-14 0 -14 -12 q14 -14 28 0 q0 12 -14 12 Z" />
    </svg>

    <div class="weed w1"><svg viewBox="0 0 40 160" preserveAspectRatio="none"><path d="M20 160 C6 130 34 110 18 80 C4 52 30 34 20 0 C34 30 14 54 26 80 C40 110 14 130 26 160 Z" /></svg></div>
    <div class="weed w2"><svg viewBox="0 0 40 160" preserveAspectRatio="none"><path d="M20 160 C6 130 34 110 18 80 C4 52 30 34 20 0 C34 30 14 54 26 80 C40 110 14 130 26 160 Z" /></svg></div>
    <div class="weed w3"><svg viewBox="0 0 40 160" preserveAspectRatio="none"><path d="M20 160 C6 130 34 110 18 80 C4 52 30 34 20 0 C34 30 14 54 26 80 C40 110 14 130 26 160 Z" /></svg></div>
    <div class="weed w4"><svg viewBox="0 0 40 160" preserveAspectRatio="none"><path d="M20 160 C6 130 34 110 18 80 C4 52 30 34 20 0 C34 30 14 54 26 80 C40 110 14 130 26 160 Z" /></svg></div>
    <div class="weed w5"><svg viewBox="0 0 40 160" preserveAspectRatio="none"><path d="M20 160 C6 130 34 110 18 80 C4 52 30 34 20 0 C34 30 14 54 26 80 C40 110 14 130 26 160 Z" /></svg></div>
    <div class="weed w6"><svg viewBox="0 0 40 160" preserveAspectRatio="none"><path d="M20 160 C6 130 34 110 18 80 C4 52 30 34 20 0 C34 30 14 54 26 80 C40 110 14 130 26 160 Z" /></svg></div>

    <div class="warm"></div>
    <div class="vignette"></div>
</div>

@code {
    /// <summary>True while free spins (or their summary banner) are showing: switches to the sunset mood.</summary>
    [Parameter] public bool Free { get; set; }

    private bool? lastFree;

    // The scene is static markup; the page re-renders many times per spin, so only re-diff when the mood flips.
    protected override bool ShouldRender()
    {
        if (lastFree == Free) return false;
        lastFree = Free;
        return true;
    }
}
