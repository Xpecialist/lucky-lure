<section class="fs-banner" aria-live="polite">
    <div class="fs-head">FREE SPINS</div>
    <div class="fs-stats">
        <div class="fs-stat"><span class="fs-label">Spins left</span><span class="fs-value">@State.FreeSpinsRemaining / @State.FreeSpinsTotal</span></div>
        <div class="fs-stat"><span class="fs-label">Multiplier</span><span class="fs-value">×@State.Multiplier</span></div>
        <div class="fs-stat"><span class="fs-label">Feature win</span><span class="fs-value">@Fmt.Money(FeatureWin ?? State.FreeSpinWin)</span></div>
    </div>

    @* Fisherman counter: PerRetrigger slots per level, then a "+10 FREE SPINS / ×N" plate for that level. *@
    <div class="fs-bar" role="img" aria-label="@BarLabel">
        @for (var g = 0; g < Levels; g++)
        {
            for (var s = 0; s < PerRetrigger; s++)
            {
                var i = g * PerRetrigger + s;
                <span class="fs-slot @(i < Filled ? "on" : null) @(i >= popFrom && i < Filled ? "pop" : null)" data-i="@i">
                    <svg viewBox="0 0 100 100" aria-hidden="true"><use href="#sym-wild" /></svg>
                </span>
            }
            var lit = Filled >= (g + 1) * PerRetrigger;
            <span class="fs-plate @(lit ? "lit" : null) @(lit && g >= platePopFrom ? "pop" : null)">
                <span class="fs-plate-spins"><b>+10</b><small>FREE SPINS</small></span>
                <span class="fs-plate-mult">×@MultiplierAt(g + 1)</span>
            </span>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter, EditorRequired] public GameInfo Info { get; set; } = default!;

    /// <summary>Final feature win to show after the last free spin (state may already be cleared).</summary>
    [Parameter] public decimal? FeatureWin { get; set; }

    /// <summary>
    /// Fishermen to show as collected while the page's collect animation is running (each slot lights up as
    /// its sparkle arrives). Null = use <see cref="GameState.WildsCollected"/>.
    /// </summary>
    [Parameter] public int? WildsShown { get; set; }

    private int PerRetrigger => Info.WildsPerRetrigger > 0 ? Info.WildsPerRetrigger : 4;
    private int Levels => Math.Max(1, (Info.Multipliers?.Count ?? 4) - 1);
    private int Slots => PerRetrigger * Levels;
    private int Filled => Math.Clamp(WildsShown ?? State.WildsCollected, 0, Slots);

    private int lastFilled = -1;     // previous render's count: only newly filled slots / plates pop
    private int popFrom = int.MaxValue;
    private int platePopFrom = int.MaxValue;

    private string BarLabel =>
        $"Fishermen collected: {Filled} of {Slots}. Every {PerRetrigger} give +10 free spins and a higher multiplier.";

    private int MultiplierAt(int level) =>
        Info.Multipliers is { } m && level < m.Count ? m[level] : 1;

    protected override void OnParametersSet()
    {
        var filled = Filled;
        if (lastFilled < 0 || filled < lastFilled)
        {
            popFrom = platePopFrom = int.MaxValue; // first render / new feature: no pop
        }
        else if (filled > lastFilled)
        {
            popFrom = lastFilled;
            platePopFrom = lastFilled / PerRetrigger; // first level that may have just been reached
        }
        lastFilled = filled;
    }
}
