@*
    One reel window. Visual modes, all animated by CSS only:
      - Spinning: a looping strip (cells rendered twice, translateY -50% -> 0, infinite).
                  It starts with the current symbols so the spin begins without a jump.
      - Landing:  [final cells + 3 filler cells] slides from -50% to 0 with a small overshoot.
      - Nudging:  (held reel gets new cells) [new cells + the cell that drops out] slides down one cell.
      - Static:   just the cells.
*@
<div class="reel @(Dim ? "dim" : null) @(Held ? "held" : null)">
    @if (Spinning)
    {
        <div class="strip looping" aria-hidden="true">
            @foreach (var cell in loop) { @CellView(cell, false) }
            @foreach (var cell in loop) { @CellView(cell, false) }
        </div>
    }
    else
    {
        <div class="strip @animClass" @key="animKey">
            @for (var row = 0; row < Cells.Length; row++)
            {
                @CellView(Cells[row], WinRows is { } w && row < w.Length && w[row])
            }
            @foreach (var cell in tail) { @CellView(cell, false) }
        </div>
    }
    @if (Held)
    {
        <span class="held-frame"><span class="held-tag">HELD</span></span>
    }
</div>

@code {
    /// <summary>The three cells (top to bottom) this reel shows when stopped.</summary>
    [Parameter, EditorRequired] public Cell[] Cells { get; set; } = [];

    /// <summary>True while the reel spins; true -> false plays the landing animation.</summary>
    [Parameter] public bool Spinning { get; set; }

    /// <summary>
    /// Held for a nudge respin: shows a HELD frame, and new <see cref="Cells"/> slide in from above by one
    /// cell (the server shifts a held reel down one row) instead of snapping.
    /// </summary>
    [Parameter] public bool Held { get; set; }

    /// <summary>Winning rows on this reel (null = none).</summary>
    [Parameter] public bool[]? WinRows { get; set; }

    /// <summary>Dim the non-winning cells.</summary>
    [Parameter] public bool Dim { get; set; }

    /// <summary>Bet used for fish values on filler symbols.</summary>
    [Parameter] public decimal FillerBet { get; set; } = 1m;

    /// <summary>Free-spin strips show the Fisherman, base-game strips show Boats.</summary>
    [Parameter] public bool FreeMode { get; set; }

    private const int LoopFillers = 5;
    private Cell[] loop = [];
    private Cell[] tail = [];      // cells rendered below the visible ones for the current animation
    private string? animClass;     // "landing" | "nudging" | null
    private int animKey;           // new key = new element = the CSS animation replays

    private bool wasSpinning;
    private Cell[]? lastCells;
    private bool[]? lastWinRows;
    private bool lastDim;
    private bool lastHeld;
    private bool dirty = true;

    protected override void OnParametersSet()
    {
        var cellsChanged = lastCells is not null && !ReferenceEquals(Cells, lastCells);

        if (Spinning && !wasSpinning)
        {
            loop = [.. Cells, .. Symbols.RandomCells(LoopFillers, FillerBet, FreeMode)];
        }
        else if (!Spinning && wasSpinning)
        {
            StartAnimation("landing", Symbols.RandomCells(Symbols.Rows, FillerBet, FreeMode));
        }
        else if (!Spinning && Held && cellsChanged && lastCells is { Length: > 0 } previous)
        {
            StartAnimation("nudging", [previous[^1]]);
        }
        else if (cellsChanged && !Spinning)
        {
            StartAnimation(null, []); // new grid without an animation (e.g. initial load)
        }

        // The parent re-renders often while spinning; only diff this reel when something changed.
        dirty = Spinning != wasSpinning || cellsChanged || !ReferenceEquals(WinRows, lastWinRows)
                || Dim != lastDim || Held != lastHeld;

        wasSpinning = Spinning;
        lastCells = Cells;
        lastWinRows = WinRows;
        lastDim = Dim;
        lastHeld = Held;
    }

    protected override bool ShouldRender() => dirty;

    private void StartAnimation(string? cssClass, Cell[] below)
    {
        animClass = cssClass;
        tail = below;
        animKey++;
    }

    private static RenderFragment CellView(Cell cell, bool win)
    {
        var meta = Symbols.Of(cell.Symbol);
        var fishValue = cell.Symbol == Symbol.Fish ? cell.Value : null;
        var label = fishValue is { } fv ? $"{meta.Name} {Fmt.Money(fv)}" : meta.Name;
        return @<div class="cell @meta.Kind @meta.Css @(win ? "win" : null)" title="@label">
                    <span class="glyph">@meta.Glyph</span>
                    @if (fishValue is { } v)
                    {
                        <span class="val">@Fmt.Short(v)</span>
                    }
                    @if (meta.Tag is not null)
                    {
                        <span class="tag">@meta.Tag</span>
                    }
                </div>;
    }
}
