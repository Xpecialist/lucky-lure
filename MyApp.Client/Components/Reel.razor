@*
    One reel window. Visual modes, all animated by CSS only:
      - Spinning: a looping strip (cells rendered twice, translateY -50% -> 0, infinite).
                  It starts with the current symbols so the spin begins without a jump.
      - Landing:  [final cells + 3 filler cells] slides from -50% to 0 with a small overshoot.
      - Nudging:  (held reel gets new cells) [new cells + the cell that drops out] slides down one cell.
      - Static:   just the cells.
*@
<div class="reel @(Dim ? "dim" : null) @(Held ? "held" : null) @(Tease ? "tease" : null)">
    @if (Spinning)
    {
        <div class="strip looping" aria-hidden="true">
            @foreach (var cell in loop) { @CellView(cell, null) }
            @foreach (var cell in loop) { @CellView(cell, null) }
        </div>
    }
    else
    {
        <div class="strip @animClass" @key="animKey">
            @for (var row = 0; row < Cells.Length; row++)
            {
                @CellView(Cells[row], RowFx(row), Cells[row].Symbol == Symbol.Scatter ? ropeMode : null)
            }
            @foreach (var cell in tail) { @CellView(cell, null) }
        </div>
    }
    @if (Tease)
    {
        @* Boat tease: glowing frame + a light sweep running down the reel while it spins longer. *@
        <span class="tease-frame" aria-hidden="true"><span class="tease-sweep"></span></span>
    }
</div>

@code {
    /// <summary>The three cells (top to bottom) this reel shows when stopped.</summary>
    [Parameter, EditorRequired] public Cell[] Cells { get; set; } = [];

    /// <summary>True while the reel spins; true -> false plays the landing animation.</summary>
    [Parameter] public bool Spinning { get; set; }

    /// <summary>
    /// Held for a nudge respin: a rope loop draws itself around the reel's Boat, and new <see cref="Cells"/>
    /// slide in from above by one cell (the server shifts a held reel down one row) instead of snapping.
    /// The rope is part of the Boat's cell, so it slides down with it; it fades when the hold ends.
    /// </summary>
    [Parameter] public bool Held { get; set; }

    /// <summary>Boat tease: this reel spins longer with a glowing frame (2 Boats are already showing).</summary>
    [Parameter] public bool Tease { get; set; }

    /// <summary>Winning rows on this reel (null = none).</summary>
    [Parameter] public bool[]? WinRows { get; set; }

    /// <summary>Rows whose Scatter (boat) celebrates: free-spin trigger or nudge tease (null = none).</summary>
    [Parameter] public bool[]? BoatRows { get; set; }

    /// <summary>
    /// Per-row effect class that wins over the marks above (net cast: "react" = fisherman reacts,
    /// "pop" = cell just turned into a Fish). Null = none.
    /// </summary>
    [Parameter] public string?[]? FxRows { get; set; }

    /// <summary>Dim the non-winning cells.</summary>
    [Parameter] public bool Dim { get; set; }

    /// <summary>Bet used for fish values on filler symbols.</summary>
    [Parameter] public decimal FillerBet { get; set; } = 1m;

    /// <summary>Free-spin strips show the Fisherman, base-game strips show Boats.</summary>
    [Parameter] public bool FreeMode { get; set; }

    private const int LoopFillers = 5;
    private Cell[] loop = [];
    private Cell[] tail = [];      // cells rendered below the visible ones for the current animation
    private string? animClass;     // "landing" | "nudging" | null
    private int animKey;           // new key = new element = the CSS animation replays
    private string? ropeMode;      // rope around the held Boat: "draw" (tease) | "keep" (nudging) | "fade" | null

    private bool wasSpinning;
    private Cell[]? lastCells;
    private bool[]? lastWinRows;
    private bool[]? lastBoatRows;
    private string?[]? lastFxRows;
    private bool lastDim;
    private bool lastHeld;
    private bool lastTease;
    private bool dirty = true;

    protected override void OnParametersSet()
    {
        var cellsChanged = lastCells is not null && !ReferenceEquals(Cells, lastCells);

        // Rope loop for the nudge respin: draws in when the hold starts, is kept (no redraw) while the strip
        // is re-created for the nudge, and fades out once the hold ends. A new spin clears it.
        if (Held && !lastHeld) ropeMode = "draw";
        else if (!Held && lastHeld) ropeMode = "fade";
        else if (Spinning && !wasSpinning) ropeMode = null;

        if (Spinning && !wasSpinning)
        {
            loop = [.. Cells, .. Symbols.RandomCells(LoopFillers, FillerBet, FreeMode)];
        }
        else if (!Spinning && wasSpinning)
        {
            StartAnimation("landing", Symbols.RandomCells(Symbols.Rows, FillerBet, FreeMode));
        }
        else if (!Spinning && Held && cellsChanged && lastCells is { Length: > 0 } previous)
        {
            StartAnimation("nudging", [previous[^1]]);
            ropeMode = "keep";
        }
        else if (cellsChanged && !Spinning)
        {
            // New cells without a strip animation (initial load, net-cast transform): keep the same strip
            // element so the cells are patched in place and per-cell effects (pop) play only where they change.
            animClass = null;
            tail = [];
        }

        // The parent re-renders often while spinning; only diff this reel when something changed.
        dirty = Spinning != wasSpinning || cellsChanged || !ReferenceEquals(WinRows, lastWinRows) || !ReferenceEquals(BoatRows, lastBoatRows) || !ReferenceEquals(FxRows, lastFxRows)
                || Dim != lastDim || Held != lastHeld || Tease != lastTease;

        wasSpinning = Spinning;
        lastCells = Cells;
        lastWinRows = WinRows;
        lastBoatRows = BoatRows;
        lastFxRows = FxRows;
        lastDim = Dim;
        lastHeld = Held;
        lastTease = Tease;
    }

    protected override bool ShouldRender() => dirty;

    private void StartAnimation(string? cssClass, Cell[] below)
    {
        animClass = cssClass;
        tail = below;
        animKey++;
    }

    private string? RowFx(int row) =>
        FxRows is { } f && row < f.Length && f[row] is { } fx ? fx
        : BoatRows is { } b && row < b.Length && b[row] ? "boat"
        : WinRows is { } w && row < w.Length && w[row] ? "win"
        : null;

    /// <summary>
    /// One cell: the symbol's SVG art (from the shared sprite), WILD/SCATTER tag, and for a Fish its cash value
    /// (money format, two decimals) inside the square tile. --len lets the CSS shrink long values to fit the tile.
    /// </summary>
    private static RenderFragment CellView(Cell cell, string? fx, string? rope = null)
    {
        var meta = Symbols.Of(cell.Symbol);
        var fishValue = cell.Symbol == Symbol.Fish && cell.Value is { } fv ? Fmt.Money(fv) : null;
        var label = fishValue is not null ? $"{meta.Name} {fishValue}" : meta.Name;
        return @<div class="cell @meta.Css @fx" title="@label">
                    <svg class="art" viewBox="0 0 100 100" aria-hidden="true"><use href="@meta.Art" /></svg>
                    @if (fishValue is not null)
                    {
                        <span class="val" style="--len: @fishValue.Length">@fishValue</span>
                    }
                    @if (meta.Tag is not null)
                    {
                        <span class="tag">@meta.Tag</span>
                    }
                    @if (rope is not null)
                    {
                        @* Rope loop: tan core (drawn in with a dash animation), dark twist bands, highlight, knot. *@
                        <svg class="rope @rope" viewBox="0 0 100 100" aria-hidden="true">
                            <path class="rope-core" pathLength="100" d="M79.6 83.7 A46 44 0 1 1 87.7 75.2" />
                            <path class="rope-twist" d="M79.6 83.7 A46 44 0 1 1 87.7 75.2" />
                            <path class="rope-shine" d="M79.6 83.7 A46 44 0 1 1 87.7 75.2" />
                            <g class="rope-knot">
                                <path d="M84 79 q5 7 3 15 M84 79 q8 3 13 2" />
                                <circle cx="84" cy="79" r="5" />
                            </g>
                        </svg>
                    }
                </div>;
    }
}