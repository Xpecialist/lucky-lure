@* Feature message (free spins awarded / retrigger / complete). Never auto-dismisses: click, Space or Enter. *@
<div class="overlay @Kind" role="dialog" aria-modal="true" aria-labelledby="ov-title" tabindex="-1"
     @ref="root" @onclick="OnDismiss">
    <div class="overlay-card">
        <h2 id="ov-title" class="ov-title">@Title</h2>
        <p class="ov-text">@Text</p>
        <p class="ov-hint">Click or press Space to continue</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";

    /// <summary>"trigger", "retrigger" or "end".</summary>
    [Parameter] public string? Kind { get; set; }

    [Parameter] public EventCallback OnDismiss { get; set; }

    private ElementReference root;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move focus into the dialog for screen readers, without scrolling the page.
        if (firstRender) await root.FocusAsync(preventScroll: true);
    }
}
