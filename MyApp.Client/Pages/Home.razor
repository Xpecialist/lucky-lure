@page "/"

<PageTitle>Lucky Lure</PageTitle>

@* Header and FREE SPINS banner share one slot (stacked in the same grid cell), so the reels never move when
   the feature starts or ends — no layout jump under the overlays. *@
<div class="masthead @(ShowBanner ? "feature" : null)">
    <header class="header">
        <h1 class="title" tabindex="-1"><span class="title-hook" aria-hidden="true">🎣</span> Lucky Lure</h1>
        <p class="play-note">Play money only · no real-money wagering</p>
    </header>
    @if (Ready)
    {
        <FreeSpinBanner State="state!" Info="info!" FeatureWin="featureWinOverride" />
    }
</div>

@* .cabinet only matters on wide screens: there the SPIN column sits to the right of the reels (see app.css). *@
<div class="cabinet">
<main class="machine">
    <div class="frame @(netShake ? "shake" : null)">
        <div class="reels" aria-label="Reels">
            @for (var r = 0; r < Symbols.Reels; r++)
            {
                var reel = r;
                <Reel Cells="grid[reel]"
                      Spinning="reelSpinning[reel]"
                      Held="heldReels[reel]"
                      WinRows="winMarks?[reel]"
                      BoatRows="boatMarks?[reel]"
                      FxRows="netFx?[reel]"
                      Dim="winMarks is not null || boatMarks is not null"
                      FillerBet="fillerBet"
                      FreeMode="fillerFree" />
            }
            <PaylineTrace @key="traceId" Lines="traceLines" Paylines="info?.Paylines" />
            @if (netCast is not null)
            {
                <NetCastFx Size="netCast.Size" />
            }
        </div>
    </div>
    <div class="message @messageKind" aria-live="polite">@message</div>
</main>

<section class="controls" aria-label="Controls">
    <div class="stat">
        <span class="stat-label">Balance</span>
        <span class="stat-value">@(state is null ? "—" : Fmt.Money(displayBalance))</span>
    </div>

    <div class="stat bet-box @(InFeature ? "locked" : null)">
        <span class="stat-label">Bet @if (InFeature) { <span class="bet-lock">(locked)</span> }</span>
        <div class="bet-row">
            <button class="bet-btn" type="button" aria-label="Decrease bet"
                    disabled="@(!CanChangeBet || betIndex <= 0)" @onclick="() => ChangeBet(-1)">−</button>
            <span class="stat-value">@(Ready ? Fmt.Money(CurrentBet) : "—")</span>
            <button class="bet-btn" type="button" aria-label="Increase bet"
                    disabled="@(!CanChangeBet || betIndex >= BetCount - 1)" @onclick="() => ChangeBet(1)">+</button>
        </div>
    </div>

    <div class="stat">
        <span class="stat-label">Win</span>
        <span class="stat-value">@Fmt.Money(winAmount)</span>
    </div>

    <div class="actions">
        <button class="auto-btn" type="button" aria-pressed="@(autoOn ? "true" : "false")" @onclick="ToggleAutoAsync">
            @(autoOn ? "Auto: ON" : "Auto")
        </button>
        <button class="spin-btn @(InFeature ? "free" : null)" type="button"
                disabled="@(!Ready || busy)" @onclick="SpinAsync">
            @(InFeature ? "FREE SPIN" : "SPIN")
        </button>
        <button class="reset-link" type="button" disabled="@(!Ready || busy || resetting)" @onclick="ResetAsync">
            Reset balance
        </button>
    </div>
</section>
</div>

<Paytable Info="info" Bet="CurrentBet" />

<footer class="footer">Lucky Lure is a game for entertainment. Balances are play money and have no cash value.</footer>

@if (netCast is not null)
{
    @* Transparent layer: a click anywhere (or Space/Enter, via [data-skippable]) skips the net-cast animation. *@
    <div class="skip-layer" data-skippable @onclick="celebrationGate.Skip"></div>
}

@if (celebration is not null)
{
    <WinCelebration @key="celebration" Tier="celebration.Tier" Amount="celebration.Amount" RollMs="celebration.RollMs"
                    ReducedMotion="reducedMotion" OnSkip="celebrationGate.Skip" />
}

@if (overlay is not null)
{
    <Overlay @key="overlay" Title="@overlay.Title" Text="@overlay.Text" Kind="@overlay.Kind" OnDismiss="overlayGate.Skip" />
}
